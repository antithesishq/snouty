{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.antithesis/snouty",
  "title": "snouty",
  "description": "Launch and triage Antithesis runs, run commands at a moment of a run, and search the docs",
  "repository": {
    "url": "https://github.com/antithesishq/snouty",
    "source": "github"
  },
  "version": "0.9.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "snouty",
      "version": "0.9.1",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
