#!/bin/sh
# A stand-in for docker-compose on the arm64 macOS CI leg. See the `podman`
# shim beside this file for why these exist at all.
#
# `snouty doctor` reports whether a usable Docker Compose v2 is present, and
# `specs/doctor.txt` needs doctor to exit zero. This answers the single probe
# that check makes — `docker-compose version --short`, see `detect_supported`
# in src/compose.rs — and fails every other invocation, so nothing that
# actually drives compose can run against it unnoticed.
if [ "$1" = "version" ] && [ "$2" = "--short" ]; then
  # Must parse as v2 and be at least MIN_COMPOSE_VERSION in src/compose.rs.
  echo "2.39.1"
  exit 0
fi

echo "docker-compose shim: '$*' needs a container engine, which the arm64 macOS runner cannot run" >&2
echo "docker-compose shim: compose-backed tests belong on the Intel leg; see .config/nextest.toml" >&2
exit 1
