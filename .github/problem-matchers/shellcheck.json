{
  "problemMatcher": [
    {
      "owner": "shellcheck",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^([^:]+):(\\d+):(\\d+): ((?:error|warning|note): .+ \\[(SC\\d+)\\])$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4,
          "code": 5
        }
      ]
    }
  ]
}
