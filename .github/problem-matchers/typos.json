{
  "problemMatcher": [
    {
      "owner": "typos",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^(?:\\./)?([^:]+):(\\d+):(\\d+): error: (`.+` should be .+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      ]
    }
  ]
}
